# ---- Firebase web config (public, used only for sign-in in the browser) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server only) ----
# Local: path to the service account JSON downloaded from
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Hosting (Vercel etc.): instead of a file, set these three
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- AI (server only, never exposed to the browser) ----
# Any OpenAI-compatible chat API with tool calling. Default = Google Gemini free tier.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.1-flash-lite

# ---- Optional first-run Admin (otherwise the setup screen asks for it) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
